@model Mission06_Zarges.Models.Movie

<h2 class="mt-3">Delete Movie</h2>

<div class="alert alert-danger mt-3">
    <h4>Are you sure you want to delete this movie?</h4>
</div>

<div class="mt-3">
    <strong>@Model.Title</strong> (@Model.Year)
</div>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>